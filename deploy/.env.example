# Variáveis da API na VPS. Cole na aba "Environment" do serviço Compose no
# Easypanel (ou num .env ao lado do docker-compose.yml, se rodar sem ele).
# NUNCA versione o arquivo com os valores reais.

# --- Banco -------------------------------------------------------------------
POSTGRES_USER=postgres
# Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=eagles

# --- Segurança (obrigatória) -------------------------------------------------
# Mínimo 32 caracteres. Gere com: openssl rand -hex 32
# Trocar este valor desconecta todo mundo (todos os tokens deixam de valer).
JWT_SECRET=

# --- Endereços ---------------------------------------------------------------
# Site principal (Firebase Hosting). Usado nos links de convite e de senha.
FRONTEND_URL=https://TROQUE-PELO-ID-DO-PROJETO.web.app
# Outros endereços do mesmo app, separados por vírgula: o domínio alternativo
# do Firebase e o APK Android (Capacitor), que chama a API como https://localhost.
CORS_ORIGINS=https://TROQUE-PELO-ID-DO-PROJETO.firebaseapp.com,https://localhost
# Endereço HTTPS desta API (o domínio configurado no Easypanel).
# Precisa ser igual ao PUBLIC_API_URL do .env.production do frontend.
PUBLIC_API_URL=https://api.164-152-195-199.sslip.io

# --- E-mail de "esqueci minha senha" (Nodemailer + SMTP) ---------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Gmail: use uma "senha de app", não a senha da conta.
SMTP_PASS=

# --- WhatsApp do conselheiro (solicitação de cadastro) -----------------------
# Só dígitos, com DDI e DDD. Ex.: 5591999999999. Vazio = sem link de WhatsApp.
WHATSAPP_CONSELHEIRO=

# --- Backup (obrigatório antes de colocar no ar) -----------------------------
# Senha que criptografa os backups. Mínimo 16 caracteres. Gere com:
#   openssl rand -base64 24
# GUARDE EM LUGAR SEGURO FORA DA VPS (gerenciador de senhas): sem ela, nenhum
# backup pode ser restaurado — nem por você.
BACKUP_SENHA=
# Hora do backup diário (0–23, horário de Brasília).
BACKUP_HORA=3
# Cópia fora da VPS — Backblaze B2 (10 GB grátis). Crie um bucket PRIVADO e uma
# "Application Key" com acesso só a ele: keyID → CONTA, applicationKey → CHAVE.
BACKUP_B2_CONTA=
BACKUP_B2_CHAVE=
BACKUP_B2_BUCKET=
# Alternativa (outro provedor): rclone.conf em base64 e o destino, ex.:
#   BACKUP_RCLONE_CONF=$(base64 -w0 ~/.config/rclone/rclone.conf)
#   BACKUP_DESTINO=meuremoto:pasta/eagles
BACKUP_RCLONE_CONF=
BACKUP_DESTINO=
