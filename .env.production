# Configuração PÚBLICA do build de produção do SPA (Firebase Hosting e APK).
#
# Este arquivo é versionado de propósito: tudo aqui vai parar dentro do
# JavaScript que qualquer visitante baixa. NUNCA coloque segredo aqui —
# segredos da API ficam no Easypanel (ver deploy/.env.example).

# Endereço HTTPS da API na VPS. Trocar por um domínio próprio quando houver.
PUBLIC_API_URL=https://api.164-152-195-199.sslip.io

# Endereço público do app (Firebase Hosting), sem barra no fim. Usado na
# prévia de links do WhatsApp (og:image precisa de endereço absoluto).
# Trocar junto com o domínio próprio, quando houver.
PUBLIC_SITE_URL=https://eagles-app-pg.web.app
