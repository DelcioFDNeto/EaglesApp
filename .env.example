# Eagles App — DESENVOLVIMENTO LOCAL. Copie para .env (`cp .env.example .env`).
# NUNCA versione o .env. As variáveis de produção ficam em deploy/.env.example
# (e no Easypanel), não aqui.

NODE_ENV=development

# Banco local. Suba com:
#   docker compose -f deploy/docker-compose.dev.yml up -d
DATABASE_URL=postgres://eagles:troque-esta-senha@localhost:5432/eagles

# Origem do app. Usada para montar os links de convite e de redefinição.
PUBLIC_ORIGIN=http://localhost:5173

# Sessão (e o JWT, que vence junto com ela): 30 dias, conforto no celular.
SESSION_TTL_DAYS=30

# Validade do link de convite.
INVITE_TTL_DAYS=7

# Senhas erradas seguidas antes de bloquear a conta (o bloqueio dobra a cada vez).
MAX_LOGIN_ATTEMPTS=5

# JWT_SECRET não é necessário aqui: em desenvolvimento a API gera um por
# processo (os logins caem quando o servidor reinicia).
