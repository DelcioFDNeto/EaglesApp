# Eagles App — copie para .env e preencha.
# NUNCA versione o .env. Segredos ficam fora do repositório (seção 16.6).

NODE_ENV=development

# Banco. Em desenvolvimento com Docker:
#   docker compose -f infra/docker-compose.yml up -d postgres
DATABASE_URL=postgres://eagles:troque-esta-senha@localhost:5432/eagles

# Origem pública. Usada para montar o link do convite que vai no WhatsApp.
PUBLIC_ORIGIN=http://localhost:5173

# Sessão longa: conforto no celular. Operações sensíveis pedem reautenticação.
SESSION_TTL_DAYS=30

# Validade do link de convite.
INVITE_TTL_DAYS=7

# Tentativas de senha antes do bloqueio progressivo.
MAX_LOGIN_ATTEMPTS=5

# --- Só em produção (infra/docker-compose.yml) ------------------------------
# DOMINIO=app.seudominio.com.br
# ACME_EMAIL=voce@seudominio.com.br
# POSTGRES_PASSWORD=gere-uma-senha-forte-aqui
# B2_BUCKET=eagles-backup     # cópia externa do backup — não deixe vazio
